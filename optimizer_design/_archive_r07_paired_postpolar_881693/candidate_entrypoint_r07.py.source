#!/usr/bin/env python3
"""Inject the current opaque R07 candidate without changing the trainer."""

from __future__ import annotations

try:
    from . import candidate_entrypoint_r01 as base
except ImportError:
    import candidate_entrypoint_r01 as base

from optimizer_design.rlb_r07 import R07Optimizer


class R07CompositeOptimizer(base.R01CompositeOptimizer):
    """Schema-checked R07 with inherited attention and AdamW ownership."""

    def state_dict(self):
        return {
            "schema": "r07_paired_adaptive_frame_composite_v2",
            "roles": self._ROLES,
            "children": [child.state_dict() for child in self.optimizers],
        }

    def load_state_dict(self, state_dict):
        if (
            not isinstance(state_dict, dict)
            or set(state_dict) != {"schema", "roles", "children"}
            or state_dict.get("schema")
            != "r07_paired_adaptive_frame_composite_v2"
            or tuple(state_dict.get("roles", ())) != self._ROLES
            or len(state_dict.get("children", ())) != len(self.optimizers)
        ):
            raise RuntimeError("R07 composite checkpoint schema changed")
        for child, child_state in zip(self.optimizers, state_dict["children"]):
            child.load_state_dict(child_state)


def main():
    base.CANDIDATES = {"r07": R07Optimizer}
    base.R01CompositeOptimizer = R07CompositeOptimizer
    base.main()


if __name__ == "__main__":
    main()
